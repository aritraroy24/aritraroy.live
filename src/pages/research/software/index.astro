---
// layout import
import Layout from "@layouts/Layout.astro";

// component import
import Header from "@components/AstroIslands/Common/Header";
import Footer from "@components/AstroComponents/Footer.astro";
import Socials from "@components/AstroComponents/Socials.astro";

// defining page title and description
const {
  pageTitle = "Aritra Roy | Software & Code",
  pageDescription = "Explore my software contributions and code repositories in computational materials science.",
  frontmatter,
  cover,
} = Astro.props;

import "../../../assets/styles/repos.scss";
---

<Layout title={pageTitle} description={pageDescription} {frontmatter} {cover}>
  <Header isHomePage={false} client:only="react" />
  <Socials />
  <div class="postsNavigationDiv">
    <!-- software heading section -->
    <h1 class="software-main-title">Software & Code</h1>
    <p class="software-subtitle">
      Research-related software contributions and code repositories
    </p>

    <!-- Loading Indicator -->
    <div id="repos-loader" class="repos-loader">
      <div class="loader-spinner"></div>
      <p>Loading repositories...</p>
    </div>

    <!-- Repositories Container -->
    <div id="repos-container" class="repos-container">
      <!-- Repository cards will be dynamically loaded from GitHub -->
    </div>
  </div>
  <Footer />
</Layout>

<script src="../../../assets/js/github-repos.js"></script>

<style>
  .postsNavigationDiv {
    min-height: 50vh !important;
    padding: 40px 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .software-main-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 20px;
    color: #ffffff;
  }

  .software-subtitle {
    text-align: center;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
    margin-bottom: 50px;
  }

  @media (max-width: 768px) {
    .software-main-title {
      font-size: 2rem;
    }

    .software-subtitle {
      font-size: 1rem;
    }
  }
</style>
