---
// layout import
import Layout from "@layouts/Layout.astro";

// component import
import Header from "@components/AstroIslands/Common/Header";
import Footer from "@components/AstroComponents/Footer.astro";
import Socials from "@components/AstroComponents/Socials.astro";

// defining page title and description for all publications page
const {
  pageTitle = "Aritra Roy | Publications",
  pageDescription = "Explore my research publications and scholarly works in computational materials science.",
  frontmatter,
  cover,
} = Astro.props;

import "../assets/styles/publications.scss";
---

<Layout title={pageTitle} description={pageDescription} {frontmatter} {cover}>
  <Header isHomePage={false} client:only="react" />
  <Socials />
  <div class="postsNavigationDiv">
    <!-- publications heading section -->
    <h1 class="publications-main-title">Our Publications</h1>
    <p class="publications-subtitle">
      Explore my latest research contributions and scholarly works
    </p>

    <!-- Loading Indicator -->
    <div id="publications-loader" class="publications-loader">
      <div class="loader-spinner"></div>
      <p>Loading publications...</p>
    </div>

    <!-- Publications Container -->
    <div id="publications-container" class="publications-list-grouped">
      <!-- Publications will be dynamically loaded from ORCID -->
    </div>

    <!-- Explore More Button -->
    <div class="publications-explore">
      <a
        href="https://scholar.google.nl/citations?user=YOUR_SCHOLAR_ID&hl=en"
        class="btn btn-primary"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="ai ai-google-scholar"></i> Explore More on Google Scholar
      </a>
    </div>
  </div>
  <Footer />
</Layout>

<script src="../assets/js/publications.js"></script>

<style>
  .postsNavigationDiv {
    min-height: 50vh !important;
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .publications-main-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 20px;
    color: #ffffff;
  }

  .publications-subtitle {
    text-align: center;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
    margin-bottom: 50px;
  }

  .publications-explore {
    text-align: center;
    margin-top: 60px;
    padding-bottom: 40px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 32px;
    font-size: 1rem;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.3s ease;
    font-weight: 600;
  }

  .btn-primary {
    background-color: #60ffd9;
    color: #0a192f;
  }

  .btn-primary:hover {
    background-color: #4dd9b8;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(96, 255, 217, 0.3);
  }

  @media (max-width: 768px) {
    .publications-main-title {
      font-size: 2rem;
    }

    .publications-subtitle {
      font-size: 1rem;
    }
  }
</style>
