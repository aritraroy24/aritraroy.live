---
// layout import
import Layout from "@layouts/Layout.astro";

// component import
import Header from "@components/AstroIslands/Common/Header";
import ContactSection from "@components/AstroComponents/Contact.astro";
import Socials from "@components/AstroComponents/Socials.astro";
import Footer from "@components/AstroComponents/Footer.astro";

// title & description value to pass to the layout
const {
  pageTitle = "Contact | Aritra Roy",
  pageDescription = "Get in touch with me for collaborations, inquiries, or just to say hello.",
  frontmatter,
  cover,
} = Astro.props;
---

<Layout title={pageTitle} description={pageDescription} {frontmatter} {cover}>
  <Header client:only="react" />
  <Socials />
  <ContactSection />
  <Footer />
</Layout>
