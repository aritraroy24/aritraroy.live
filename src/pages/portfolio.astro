---
// layout import
import Layout from "@layouts/Layout.astro";

// component import
import Header from "@components/AstroIslands/Common/Header";
import PortfolioSection from "@components/AstroComponents/Portfolio.astro";
import Socials from "@components/AstroComponents/Socials.astro";
import Footer from "@components/AstroComponents/Footer.astro";

// title & description value to pass to the layout
const {
  pageTitle = "Portfolio | Aritra Roy",
  pageDescription = "Explore my portfolio of computational materials science projects and achievements.",
  frontmatter,
  cover,
} = Astro.props;
---

<Layout title={pageTitle} description={pageDescription} {frontmatter} {cover}>
  <Header client:only="react" />
  <Socials />
  <PortfolioSection />
  <Footer />
</Layout>
