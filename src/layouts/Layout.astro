---
import { Image } from "astro:assets";
// component import
import GoogleAnalytics from "@components/Meta/GoogleAnalytics.astro";
import Seo from "@components/Meta/Seo.astro";

// style import
import "@assets/styles/global.scss";

// defining type of title and description of the page
export interface LayoutProps {
  title?: string;
  description?: string;
  cover?: string;
  frontmatter?: any;
}

// default values of title and description of the page
const {
  title = "Aritra Roy | Computational Materials Scientist",
  description = "I'm a Theoretical Computational Materials Scientist & Algorithm Enthusiast from India. I have expertise in theory, software handling, & problem-solving skill.",
  cover,
  frontmatter,
} = Astro.props as LayoutProps;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <GoogleAnalytics />

    <!-- metadata section -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <Seo {title} {description} url={Astro.url} {cover} {frontmatter} />

    <!-- favicon, font and other stylesheets import -->
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="apple-touch-icon" href="/logo180.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>
    <title>{title}</title>
  </head>
  <body>
    <noscript
      >You need to enable JavaScript to run all the functionality of this
      website.</noscript
    >
    <div id="preloader">
      <Image src="/preloader.svg" alt="Loading..." width={150} height={150} />
    </div>
    <div id="root" style="display: none;">
      <slot />
    </div>
    <div id="turnstile-gate" data-site-key={turnstileSiteKey} style="display: none;">
      <div class="turnstile-gate-card">
        <h2>Security Check</h2>
        <p>Please verify to continue browsing.</p>
        <div id="turnstile-widget"></div>
        <p id="turnstile-gate-error" style="display: none;"></p>
      </div>
    </div>
    <script>
      (function (window) {
        var unknown = "-";
        var os = unknown;
        var osVersion = unknown;
        var mobile = /Mobile|mini|Fennec|Android|iP(ad|od|hone)/.test(
          navigator.userAgent
        );
        var screenSize = "";

        if (mobile) {
          var nVer = navigator.appVersion;
          var nAgt = navigator.userAgent;

          var clientStrings = [{ s: "iOS", r: /(iPhone|iPad|iPod)/ }];

          for (var id in clientStrings) {
            var cs = clientStrings[id];
            if (cs.r.test(nAgt)) {
              os = cs.s;
              if (os === "iOS") {
                osVersion = /OS (\d+)_(\d+)_?(\d+)?/.exec(nVer)!![1];
                osVersion =
                  osVersion[1] +
                  "." +
                  osVersion[2] +
                  "." +
                  (osVersion[3] || "0");
                break;
              }
            }
          }

          if (screen.width) {
            var width = screen.width;
            var height = screen.height;
            screenSize = width + " x " + height;
          }

          if (os === "iOS" && screen.width < 730) {
            const footerSocials = document.getElementById("footerSocials");
            const footer = document.getElementById("footer");
            if (footerSocials !== null) {
              footerSocials.style.display = "none";
            }
            if (footer !== null) {
              footer.style.minHeight = "200px";
            }
          }
        }
      })(this);

      // setInterval(function () {
      //   console.clear();
      //   console.log(`
      //  █████╗ ██████╗ ██╗████████╗██████╗  █████╗     ██████╗  ██████╗ ██╗   ██╗
      // ██╔══██╗██╔══██╗██║╚══██╔══╝██╔══██╗██╔══██╗    ██╔══██╗██╔═══██╗╚██╗ ██╔╝
      // ███████║██████╔╝██║   ██║   ██████╔╝███████║    ██████╔╝██║   ██║ ╚████╔╝
      // ██╔══██║██╔══██╗██║   ██║   ██╔══██╗██╔══██║    ██╔══██╗██║   ██║  ╚██╔╝
      // ██║  ██║██║  ██║██║   ██║   ██║  ██║██║  ██║    ██║  ██║╚██████╔╝   ██║
      // ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝   ╚═╝   ╚═╝  ╚═╝╚═╝  ╚═╝    ╚═╝  ╚═╝ ╚═════╝    ╚═╝

      // Research Assistant / Doctoral Researcher,
      // Chemical Process and Energy Engineering,
      // London South Bank University, UK
      // `);
      // }, 5000);
    </script>
    <script is:inline>
      (function () {
        const gate = document.getElementById("turnstile-gate");
        if (!gate) return;

        const siteKey = gate.getAttribute("data-site-key") || "";
        if (!siteKey) return;

        const errorNode = document.getElementById("turnstile-gate-error");
        const preloader = document.getElementById("preloader");

        const showGate = () => {
          gate.style.display = "flex";
          document.body.classList.add("turnstile-locked");
          if (preloader) preloader.style.display = "none";
        };

        const hideGate = () => {
          gate.style.display = "none";
          document.body.classList.remove("turnstile-locked");
        };

        const showError = (msg) => {
          if (!errorNode) return;
          errorNode.textContent = msg || "Verification failed. Please try again.";
          errorNode.style.display = "block";
        };

        const clearError = () => {
          if (!errorNode) return;
          errorNode.textContent = "";
          errorNode.style.display = "none";
        };

        if (sessionStorage.getItem("turnstile_passed") === "1") {
          hideGate();
          return;
        }

        showGate();

        let widgetId = null;
        const renderWidget = () => {
          if (!window.turnstile || widgetId !== null) return;

          widgetId = window.turnstile.render("#turnstile-widget", {
            sitekey: siteKey,
            theme: "dark",
            callback: async (token) => {
              clearError();
              try {
                const response = await fetch("/turnstile-verify.php", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ token }),
                });
                const result = await response.json();
                if (response.ok && result.success) {
                  sessionStorage.setItem("turnstile_passed", "1");
                  hideGate();
                  return;
                }
                showError(result.message || "Verification rejected. Please retry.");
              } catch (error) {
                showError("Unable to verify challenge. Please retry.");
              }

              if (window.turnstile && widgetId !== null) {
                window.turnstile.reset(widgetId);
              }
            },
            "error-callback": () => {
              showError("Challenge failed to load. Please retry.");
            },
            "expired-callback": () => {
              showError("Challenge expired. Please verify again.");
            },
          });
        };

        const checkTurnstileReady = setInterval(() => {
          if (window.turnstile) {
            clearInterval(checkTurnstileReady);
            renderWidget();
          }
        }, 100);

        setTimeout(() => clearInterval(checkTurnstileReady), 15000);
      })();
    </script>
  </body>
</html>
