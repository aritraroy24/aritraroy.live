---
import Newsletter from "./Common/Newsletter.astro";
import "./styles/FooterWithoutSocial.scss";
---

<footer class="Footer" id="footer" style="height: unset;">
  <Newsletter />
  <div class="copyrightDiv">
    <p>
      &copy; <span id="copyright-year-no-social"></span> <a href="/"><span>aritraroy.live</span></a>
    </p>
    <p>❤️</p>
    <p>All rights reserved.</p>
  </div>
</footer>

<script>
  document.getElementById('copyright-year-no-social')!.textContent = new Date().getFullYear().toString();
</script>
