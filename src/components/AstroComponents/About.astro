---
// library import
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// data import
import researchTools from "@assets/js/data/researchTools";
import programmingTools from "@assets/js/data/programmingTools";

// asset import
import headshot from "@images/about/headshot.jpg";

// style import
import "./styles/About.scss";

type ToolLink = {
  id: number;
  url: string;
  iconName: string;
  title: string;
};

const allToolsByTitle: Record<string, ToolLink> = {};
programmingTools.forEach((group: Record<string, ToolLink[]>) => {
  Object.values(group).forEach((tools) => {
    tools.forEach((tool) => {
      allToolsByTitle[tool.title] = tool;
    });
  });
});

const focusedStacks = [
  {
    title: "Web Stack",
    description: "Core stack I use most for modern web experiences.",
    tools: ["Astro", "React", "JavaScript", "TypeScript", "Node.js", "Tailwind CSS"],
  },
  {
    title: "AI Workflow",
    description: "Tools that power my LLM-assisted research and prototyping flow.",
    tools: ["Python", "PyTorch", "LangChain", "LangGraph", "CrewAI", "Hugging Face"],
  },
  {
    title: "Research Computing",
    description: "Numerical and scientific stack for chemistry/materials workflows.",
    tools: ["NumPy", "pandas", "scikit-learn", "Linux", "Docker", "GitHub"],
  },
];
---

<main class="AboutMe" id="about" data-name="AboutMe">
  <h1>About Me</h1>
  <section class="about-box">
    <!-- about description - left section -->
    <section class="about-description">
      <!-- Three paragraphs version for large screens -->
      <div class="text-large-screen">
        <p>
          Currently, I'm a doctoral researcher at <a
            href="https://slimeslab.github.io/"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink"
          >
            SLIMES
          </a> lab in <b>Chemical Process and Energy Engineering Dept.</b> of <a
            href="https://www.lsbu.ac.uk/"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink"
          >
            LSBU, UK
          </a> under {" "}
          <a
            href="https://scholar.google.com.sg/citations?user=hfyoL4AAAAAJ&hl=en"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink"
          >
            Dr John Buckeridge
          </a> and
          <a
            href="https://scholar.google.co.uk/citations?user=cwB7NzAAAAAJ&hl=en"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink"
          >
            Dr Chiara Gattinoni
          </a>.
        </p>
        <p>
          Along with that, I'm working on multiple collaborative projects
          primarily under the guidance of {" "}
          <a
            href="https://www.felipefantuzzi.org/"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink"
          >
            Dr Felipe Fantuzzi
          </a> from Kent University.
        </p>
        <p>
          My PhD project focuses on <b
            >using text-mining and deep-learning to design piezoelectric
            materials</b
          >. I have expertise in the <a
            href="https://www.vasp.at/"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink"
          >
            VASP
          </a> simulation package and in various LLM-based techniques for text-mining
          scientific literature and data extraction (e.g., <a
            href="https://slimeslab.github.io/ComProScanner/"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink">ComProScanner</a
          >), and I enjoy participating in AI for Science initiatives and
          challenges (e.g., <a
            href="https://github.com/blaiszik/microstack"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink">μStack</a
          >).
        </p>
      </div>

      <!-- One paragraph version for small screens -->
      <div class="text-small-screen">
        <p>
          Currently, I'm a doctoral researcher at <a
            href="https://slimeslab.github.io/"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink"
          >
            SLIMES
          </a> lab in <b>Chemical Process and Energy Engineering Dept.</b> of <a
            href="https://www.lsbu.ac.uk/"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink"
          >
            LSBU, UK
          </a> under {" "}
          <a
            href="https://scholar.google.com.sg/citations?user=hfyoL4AAAAAJ&hl=en"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink"
          >
            Dr John Buckeridge
          </a> and
          <a
            href="https://scholar.google.co.uk/citations?user=cwB7NzAAAAAJ&hl=en"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink"
          >
            Dr Chiara Gattinoni
          </a>. Along with that, I'm working on multiple collaborative projects
          primarily under the guidance of {" "}
          <a
            href="https://www.felipefantuzzi.org/"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink"
          >
            Dr Felipe Fantuzzi
          </a> from Kent University. My PhD project focuses on <b
            >using text-mined scientific data to design piezoelectric materials</b
          >. I have expertise in the <a
            href="https://www.vasp.at/"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink"
          >
            VASP
          </a> simulation package and in various LLM-based techniques for text-mining
          scientific literature and data extraction (e.g., <a
            href="https://slimeslab.github.io/ComProScanner/"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink">ComProScanner</a
          >), and I enjoy participating in AI for Science initiatives and
          challenges (e.g., <a
            href="https://github.com/blaiszik/microstack"
            target="_blank"
            rel="noopener noreferrer"
            class="hyperlink">μStack</a
          >).
        </p>
      </div>

      <p>Here are a few tools I've been working with recently:</p>
      <section class="skills">
        <ul>
          {
            researchTools.map((tool: any) => {
              if (tool.id % 2 != 0) {
                return (
                  <li>
                    <span>▹ </span>
                    {tool.toolName}
                    <span class="es6">{tool.version}</span>
                  </li>
                );
              }
            })
          }
        </ul>
        <ul>
          {
            researchTools.map((tool: any) => {
              if (tool.id % 2 == 0) {
                return (
                  <li>
                    <span>▹ </span>
                    {tool.toolName}
                    <span class="es6">{tool.version}</span>
                  </li>
                );
              }
            })
          }
        </ul>
      </section>
    </section>
    <!-- about image - right section -->
    <section class="img-container">
      <Image
        src={headshot}
        alt="Aritra Face"
        width={800}
        height={800}
        quality="high"
      />
    </section>
  </section>
  <div class="iconsContainer">
    <div class="stackIntro">
      <h2>Technologies that shape how I build</h2>
      <p>
        A focused snapshot of the tools I rely on most for research, engineering,
        and AI-enabled workflows.
      </p>
    </div>
    <div class="stackGrid">
      {
        focusedStacks.map((stack) => (
          <div class="langIcons">
            <p>{stack.title}</p>
            <span class="stackDescription">{stack.description}</span>
            <div>
              {
                stack.tools
                  .map((name) => allToolsByTitle[name])
                  .filter(Boolean)
                  .map((tool) => (
                    <a href={tool.url} class="iconLink" target="_blank" rel="noopener noreferrer">
                      <Icon name={tool.iconName} title={tool.title} />
                      <span class="iconTitle">{tool.title}</span>
                    </a>
                  ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>
</main>
